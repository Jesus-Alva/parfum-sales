# ── Database ─────────────────────────
POSTGRES_USER=scentia
POSTGRES_PASSWORD=scentia_pass
POSTGRES_DB=scentia_db
DATABASE_URL=postgresql+psycopg2://scentia:scentia_pass@postgres:5432/scentia_db

# ── pgAdmin ───────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@scentia.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# ── Redis / Celery ────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── JWT ───────────────────────────────
SECRET_KEY=super_secret_key_change_me_in_prod_please_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Telegram ──────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here
TELEGRAM_CHAT_ID=123456789

# ── Frontend ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXTAUTH_SECRET=another_secret_for_nextauth_change_me
NEXTAUTH_URL=http://localhost:3000

# ── App ───────────────────────────────
PROJECT_NAME=Scentia
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1

# Ubicacion de cede
BUSINESS_CITY=Tecámac
BUSINESS_STATE=Estado de México