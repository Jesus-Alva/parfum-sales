# PostgreSQL local (Docker Compose)
POSTGRES_USER=scentia
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=scentia
DATABASE_URL=postgresql+psycopg2://scentia:change_this_local_password@postgres:5432/scentia

# Seguridad y autenticación
SECRET_KEY=replace_with_a_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Servicios internos de Docker Compose
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Frontend local: http://localhost:3005; API a través de Nginx en el puerto 80
BACKEND_CORS_ORIGINS=http://localhost:3005
FRONTEND_BASE_URL=http://localhost:3005
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3005
APP_LAN_IP=
NEXT_PUBLIC_APP_LAN_IP=

# pgAdmin local
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_this_pgadmin_password
PGADMIN_PORT=5050

# Entregas locales (opcionales para desarrollo)
BUSINESS_CITY=Tecámac
BUSINESS_STATE=Estado de México

# Correo SMTP para recuperación de contraseña (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ScentiA
SMTP_USE_TLS=true

# Notificaciones de pedidos (opcionales)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=
WHATSAPP_API_VERSION=v27.0
WHATSAPP_ORDER_TEMPLATE=scentia_new_order
WHATSAPP_TEMPLATE_LANGUAGE=es_MX

# Google Analytics / Tag Manager (opcionales)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Archivos subidos y respaldos (valores usados dentro de los contenedores)
UPLOAD_DIR=/app/uploads
BACKUP_DIR=/app/backups
